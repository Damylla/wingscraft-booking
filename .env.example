# Wingscraft Booking — Server Configuration
BOOKING_HOST=127.0.0.1
BOOKING_PORT=8080
BOOKING_DB=data/bookings.sqlite3
BOOKING_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# Wingscraft Studio — Gmail SMTP Notification Configuration
# IMPORTANT: Use a 16-character Google App Password (NOT your regular Google account password).
# Generate one at: https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=SSL
BOOKING_NOTIFY_EMAIL=wingscraft.studio@gmail.com
SMTP_USER=wingscraft.studio@gmail.com
SMTP_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
